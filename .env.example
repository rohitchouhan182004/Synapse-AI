# SYNAPSE Environment Configuration

PROJECT_NAME=SYNAPSE
ENVIRONMENT=development
DEBUG=True

# API Settings
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8000
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & JWT
SECRET_KEY=synapse-quantum-twin-secret-key-production-replace-in-real-env-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Primary Database (MySQL 8 persistent connection)
# Default MySQL URI: mysql+pymysql://root:password@localhost:3306/synapse_db
# Out-of-the-box local fallback if MySQL service is not running: sqlite:///./synapse.db
DATABASE_URL=sqlite:///./synapse.db

# LLM Integration (Optional fallback: mock)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
